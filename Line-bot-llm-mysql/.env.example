# LINE Configuration
LINE_CHANNEL_SECRET=your_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_here

# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.7

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=bookdb_user
DB_PASSWORD=your_db_password_here
DB_NAME=books_3f

# Server Configuration
PORT=3000
NODE_ENV=development

# LIFF Configuration (Optional)
LIFF_ID=your_liff_id_here
LIFF_URL=https://liff.line.me/your_liff_id_here

# Daily Scheduler Configuration
SCHEDULER_ENABLED=true
SCHEDULER_DAILY_TIME=02:00
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_DELAY_MINUTES=30
SCHEDULER_TIMEZONE=Asia/Taipei
EBOOK_PROCESSOR_PATH=../ebook/main_processor.py
PYTHON_EXECUTABLE=python
EBOOK_OUTPUT_PATH=../ebook/generated_documents

# Notification System Configuration
NOTIFICATION_MAX_RECIPIENTS_PER_BATCH=100
NOTIFICATION_DELIVERY_TIMEOUT_MS=30000
NOTIFICATION_MAX_BOOKS_PER_MESSAGE=5
NOTIFICATION_ENABLE_RICH_MESSAGES=true
NOTIFICATION_RETRY_FAILED_DELIVERIES=true
NOTIFICATION_MAX_DELIVERY_RETRIES=3
NOTIFICATION_DELIVERY_RETRY_DELAY_MINUTES=15

# ============================================
# 共享配置 (Node.js + Python 共用)
# ============================================

# 通知管道開關 (控制學員中心顯示哪些選項)
# LINE 推播：預設關閉 (成本控制)
NOTIFICATION_LINE_ENABLED=false
# Email 通知：預設開啟
NOTIFICATION_EMAIL_ENABLED=true
# 桌面通知：預設關閉 (尚未實作)
NOTIFICATION_WEBPUSH_ENABLED=false

# LINE 推播成本控制 (Python 監控使用)
# 此開關控制實際是否發送 LINE 推播，與上面的顯示開關獨立
LINE_PUSH_ENABLED=false

# SMTP 設定 (Email 通知使用)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# Python 監控系統配置
# ChromeDriver 路徑 (Windows / Linux)
# Windows: chromedriver-win64/chromedriver.exe  
# Linux/LXC: /usr/bin/chromedriver
CHROMEDRIVER_PATH=/usr/bin/chromedriver
# 下載目錄
DOWNLOAD_DIR=downloads
# 目標網站
TARGET_URL=https://www.budaedu.org
# 基準書籍標題 (用於判斷新書)
BASELINE_BOOK_TITLE=