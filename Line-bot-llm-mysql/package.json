{
  "name": "line-book-query-bot",
  "version": "1.0.0",
  "description": "A smart library assistant that integrates LINE Messaging API with Google Gemini 2.5 Pro",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "dev:simple": "ts-node src/simple-index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node scripts/migrate.ts",
    "scheduler": "ts-node scripts/scheduler.ts",
    "scheduler:start": "npm run build && node dist/scripts/scheduler.js",
    "sync:excel": "ts-node scripts/sync-excel-to-db.ts",
    "sync:file": "npm run sync:excel file",
    "sync:directory": "npm run sync:excel directory",
    "sync:monitor": "npm run sync:excel monitor",
    "sync:stats": "npm run sync:excel stats",
    "test": "jest",
    "test:ci": "jest --ci --coverage",
    "test:db": "node test-books3f-connection.js",
    "setup:db": "node create-books3f-database.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t line-book-bot .",
    "docker:run": "docker run -p 3000:3000 --env-file .env line-book-bot",
    "docker:compose:up": "docker-compose up -d",
    "docker:compose:down": "docker-compose down",
    "docker:compose:logs": "docker-compose logs -f",
    "deploy": "bash scripts/deploy.sh",
    "deploy:win": "scripts\\deploy.bat",
    "clean": "rm -rf dist coverage"
  },
  "keywords": [
    "line",
    "bot",
    "gemini",
    "ai",
    "library",
    "books"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.2.0",
    "@line/bot-sdk": "^8.0.0",
    "@types/cron": "^2.0.1",
    "axios": "^1.6.0",
    "commander": "^11.0.0",
    "cors": "^2.8.5",
    "cron": "^4.3.3",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "mysql2": "^3.0.0",
    "node-cache": "^5.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/node-cache": "^4.2.5",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
